# Server-only secret. Do not commit .env or set secrets as VITE_* variables.
ADMIN_PASSWORD=replace-this-with-your-own-password
# Local development SQLite file. Docker uses its persistent /data volume instead.
DATABASE_PATH=data/thanksgiving.sqlite

# Backend API + admin server. Docker exposes this port on 127.0.0.1 only.
# Point a host-installed cloudflared connector at http://127.0.0.1:3000.
PORT=3000

# Development only (bun run dev): public Vite site at http://localhost:5173.
# Not used by Docker, GitHub Pages, or the production tunnel.
PUBLIC_PORT=5173
# Development only: admin Vite site at http://localhost:5174/admin/.
ADMIN_PORT=5174

# Production origins: scheme + hostname (+ port if needed), without a trailing slash.
ADMIN_ORIGIN=https://garrepi.dev
COOKIE_SECURE=true

# Public build only: no secrets. Empty uses the local Vite API proxy.
VITE_API_URL=https://garrepi.dev
# Front end: https://garrepi.dev/thanksgiving-2026-survey/
# GitHub Pages workflow sets this base path automatically.
PUBLIC_BASE_PATH=/thanksgiving-2026-survey/
