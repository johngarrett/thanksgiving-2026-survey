{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "vite/client"
    ]
  },
  "include": [
    "server",
    "shared",
    "public-site",
    "admin",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "scripts"
  ]
}
